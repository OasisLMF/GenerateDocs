# Documentation toolchain for the aggregated Oasis docs build (orchestrate.py / build.sh).
# The orchestrator builds each component's OWN Sphinx docs, so this must cover the union of
# every component conf.py's extensions.

# Sphinx + theme
sphinx
furo

# MyST Markdown + executable notebooks (myst-nb bundles myst-parser)
myst-nb
myst-parser
sphinx-design
sphinx-copybutton

# Reference-generation extensions used by components
sphinx-autoapi          # OasisLMF API reference (AST-based)
sphinxcontrib-redoc     # OasisPlatform REST API reference

# OasisLMF conf.py imports the package (version + CLI options at build time);
# ods-tools drives the ODS_Tools OED notebook.
oasislmf
ods-tools>=5.0.0

# Support
sphinx-autobuild
requests
jinja2
markupsafe
docutils
lxml[html_clean]

# sphinxcontrib-redoc imports pkg_resources, removed in setuptools>=81
setuptools<81
